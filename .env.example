# ===== 应用 =====
APP_NAME="Share Helper"
APP_ENV=development
DEBUG=true

# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/sharehelper

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ===== LLM - 云端 =====
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
CLOUD_LLM_API_KEY=sk-your-api-key-here
CLOUD_LLM_MODEL=gpt-4o

# ===== LLM - 本地 =====
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# ===== 向量数据库 =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=share_memories
EMBEDDING_MODEL=text-embedding-3-small
MEMORY_SIMILARITY_THRESHOLD=0.85

# ===== 安全 =====
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
